{
  "name": "entire-upgrade",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "mounts": [
    "source=entire-upgrade-gocache,target=/home/vscode/go,type=volume"
  ],
  "postCreateCommand": "go mod download && go build ./...",
  "customizations": {
    "vscode": {
      "extensions": ["golang.go"]
    }
  }
}
